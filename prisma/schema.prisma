// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  image     String?
  role      String   @default("USER") // USER, ADMIN, VET
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
  orders    Order[]
  adoptions AdoptionListing[]
  reviews   Review[]
}

model Pet {
  id        String   @id @default(cuid())
  name      String
  type      String   // Cat, Dog, Bird, Fish, etc.
  gender    String   // M, F
  dob       DateTime?
  image     String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  medicalRecords MedicalRecord[]
  adoptionListing AdoptionListing?
}

model MedicalRecord {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  date      DateTime @default(now())
  vetName   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  category    String   // Food, Tools, Games
  image       String?
  stock       Int      @default(0)
  brand       String?
  targetPet   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  total       Float
  status      String   @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED, COMPLETED
  type        String   @default("SHOP") // SHOP, SERVICE
  serviceType String?  // MEDICAL, HOTEL, SALON
  driverName  String?
  eta         DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float
}

model AdoptionListing {
  id          String   @id @default(cuid())
  petId       String   @unique
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  listerId    String
  lister      User     @relation(fields: [listerId], references: [id])
  description String
  status      String   @default("AVAILABLE") // AVAILABLE, ADOPTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String?
  targetId  String?  // Could be product ID or service/vet ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
